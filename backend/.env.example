# ============================================
# EXAM REMUNERATION SYSTEM - ENVIRONMENT CONFIG
# ============================================
#
# This is a template file showing all required and optional environment variables.
# Copy this to .env and update with your actual values.
#
# CRITICAL: Never commit the actual .env file to version control.
# Use strong, random values for all secrets.
#

# ============================================
# NODE ENVIRONMENT
# ============================================
# Options: development, staging, production
# Default: development
NODE_ENV=development

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_USER=exam_user
DB_PASS=strong_random_password_here
DB_NAME=exam_remuneration

# ============================================
# AUTHENTICATION & SECURITY
# ============================================

# JWT Secret - CRITICAL: Use a strong random value
# Recommended: At least 32 characters, alphanumeric + special characters
# Generate with: openssl rand -base64 32
# DO NOT share or commit this value
JWT_SECRET=your_very_long_random_secret_key_min_32_characters_here

# JWT Token Expiration (in hours)
# Default: 24 hours
JWT_EXPIRES_IN=24

# ============================================
# CORS CONFIGURATION
# ============================================

# Frontend URL (main origin for CORS)
FRONTEND_URL=http://localhost:5173

# Additional allowed origins (comma-separated)
# CRITICAL: Only add trusted origins
# Format: https://app.example.com,https://admin.example.com
# DO NOT use wildcards in production
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Enable CORS debugging (shows blocked origins in logs)
DEBUG_CORS=false

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================

# Redis URL for distributed rate limiting (optional)
# If not set, uses in-memory store (suitable for single-server deployments)
# For production with multiple servers, use Redis:
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://user:password@redis-server.example.com:6379/0
REDIS_URL=

# Global rate limit: requests per window
RATE_LIMIT_GLOBAL_REQUESTS=100
RATE_LIMIT_GLOBAL_WINDOW_MS=900000  # 15 minutes in milliseconds

# Login endpoint rate limit: strict limits to prevent brute-force
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000  # 15 minutes

# Authenticated user rate limit: higher limits for legitimate users
RATE_LIMIT_AUTH_USER_REQUESTS=1000
RATE_LIMIT_AUTH_USER_WINDOW_MS=900000  # 15 minutes

# Sensitive operations rate limit: file uploads, password changes, etc.
RATE_LIMIT_SENSITIVE_REQUESTS=10
RATE_LIMIT_SENSITIVE_WINDOW_MS=3600000  # 1 hour

# ============================================
# GOOGLE INTEGRATION
# ============================================

# Google Form for external examiner registrations
GOOGLE_FORM_URL=https://docs.google.com/forms/d/your-form-id/viewform

# Google Form field ID for token submission
GOOGLE_FORM_TOKEN_FIELD_ID=your_field_id

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# ============================================
# EMAIL CONFIGURATION
# ============================================

# Email service for notifications
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=no-reply@yourinstituion.edu

# ============================================
# FILE UPLOADS
# ============================================

# Maximum file upload size in bytes
MAX_FILE_SIZE=5242880  # 5MB

# Allowed file types for uploads
ALLOWED_FILE_TYPES=.pdf,.xlsx,.xls,.jpg,.jpeg,.png

# Upload directory (relative to backend root)
UPLOAD_DIR=uploads

# ============================================
# APPLICATION-SPECIFIC CONFIG
# ============================================

# Academic year (e.g., 2025-2026)
ACADEMIC_YEAR=2025-2026

# Institution name
INSTITUTION_NAME=Your University Name

# Support email
SUPPORT_EMAIL=support@yourinstitution.edu

# ============================================
# LOGGING & DEBUGGING
# ============================================

# Authentication debug logging
DEBUG_AUTH=false

# Enable verbose logging
VERBOSE_LOGGING=false

# Log level: error, warn, info, debug
LOG_LEVEL=info

# ============================================
# SECURITY RECOMMENDATIONS
# ============================================
#
# 1. NEVER hardcode secrets in code or commit to version control
# 2. Rotate JWT_SECRET periodically (at least annually)
# 3. Use HTTPS in production (enforce with environment-specific middleware)
# 4. Keep node_modules and dependencies updated
# 5. Run security audits: npm audit
# 6. Use strong database passwords (minimum 16 characters, mixed case + numbers + symbols)
# 7. Implement API rate limiting monitoring and alerting
# 8. Log and monitor authentication failures
# 9. Use Redis for distributed rate limiting in production
# 10. Regularly review CORS allowed origins
#
